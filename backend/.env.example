HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Admin notifications (test feedback + issue reports)
# Comma-separated recipients; leave empty to disable the emails.
ADMIN_NOTIFICATION_EMAILS=
FRONTEND_URL=https://bandup.uz

# SMTP relay for outgoing email. Without SMTP_HOST, Strapi falls back to its
# default `sendmail` provider and notifications are effectively dropped.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_DEFAULT_FROM=no-reply@bandup.uz
EMAIL_DEFAULT_REPLY_TO=
